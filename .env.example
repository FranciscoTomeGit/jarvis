# LLM provider: "ollama" (local, free — install from ollama.com) or "anthropic" (paid API)
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:12b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CONTEXT_WINDOW=8192

# Speech-to-text: "whisper" (local on GPU, private) or "google" (free web API)
STT_ENGINE=whisper
STT_LANGUAGE=en
# WHISPER_MODEL=large-v3-turbo

# Anthropic — only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your_key_here
MODEL=claude-sonnet-4-6
MAX_TOKENS=2048
DB_PATH=data/conversations.db

# ElevenLabs TTS — get your key at elevenlabs.io (free tier: 10k chars/month)
# Browse voices at elevenlabs.io/voice-library — copy the voice ID from the URL
# Default: "Daniel" — British authoritative male (onwK4e9ZLuTAKqWW03F9)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Picovoice wake word — get a free key at picovoice.ai → Console → Access Key
# Say "JARVIS" to activate call mode hands-free
PICOVOICE_ACCESS_KEY=your_picovoice_key_here
